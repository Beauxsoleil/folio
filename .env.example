# PostgreSQL connection string.
# Neon: use the POOLED endpoint (host contains "-pooler") — it already
# includes ?sslmode=require, which the pg driver honors automatically.
DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional: set to "1" on a production deploy to skip auto-provisioning the
# demo library (22 seeded books) on first boot against an empty database.
# FOLIO_DISABLE_SEED="1"
